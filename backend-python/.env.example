# Copy this file to .env and replace the values for your machine.
# Never commit real credentials or production secrets.

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=clariq
DB_USER=root
DB_PASSWORD=change_me

# JWT: generate a long random value for any non-demo deployment.
SECRET_KEY=replace_with_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional: comma-separated frontend origins.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5501,http://localhost:5501

# Optional local upload directory (defaults to backend-python/uploads).
UPLOAD_DIR=
